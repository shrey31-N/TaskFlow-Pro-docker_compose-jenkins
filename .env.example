# Copy this file to .env and fill in real values before running
# `docker compose up --build`. .env itself is gitignored - never commit it.

# --- MySQL (local dev / compose only) ---
MYSQL_ROOT_PASSWORD=root
DB_NAME=taskflow_db
DB_USERNAME=taskflow
DB_PASSWORD=taskflow123

# --- JWT (must be identical across user-service and api-gateway) ---
# Generate one with: openssl rand -base64 48
JWT_SECRET=your-jwt-signing-secret
JWT_EXPIRATION=3600000

# --- Admin bootstrap ---
# Required to create the very first Admin account via
# POST /api/users/register-admin. Pick your own value - do not reuse
# any secret that has ever been committed to this repo's history.
ADMIN_SECRET_KEY=your-admin-bootstrap-secret

# --- AWS S3 (optional - profile picture uploads) ---
# Leave blank to fall back to the AWS SDK default credentials provider
# chain (e.g. an EC2/ECS instance role). Only needed for local docker
# compose runs if you want S3 uploads to work outside of AWS.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=taskflow-pro-profile-images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
