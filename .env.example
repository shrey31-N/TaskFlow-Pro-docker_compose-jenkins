# Copy this file to .env and fill in real values before running
# `docker compose up --build`. .env itself is gitignored - never commit it.

# --- MySQL (local dev / compose only) ---
MYSQL_ROOT_PASSWORD=root
DB_NAME=taskflow_db
DB_USERNAME=taskflow
DB_PASSWORD=taskflow123

# --- JWT (must be identical across user-service and api-gateway) ---
# Generate one with: openssl rand -base64 48
JWT_SECRET=MySuperSecretKeyForTaskFlowApplication123456789
JWT_EXPIRATION=3600000

# --- Admin bootstrap ---
# Required to create the very first Admin account via
# POST /api/users/register-admin. Pick your own value - do not reuse
# any secret that has ever been committed to this repo's history.
ADMIN_SECRET_KEY=adminsecretkey1234567890

# --- AWS S3 (profile picture uploads) ---
# Leaving the access key / secret blank falls back to the AWS SDK
# default credentials provider chain (e.g. an EC2/ECS instance role),
# which does not exist when running locally via docker compose - so
# uploads will fail with a 500 until these are set.
#
# Provisioned via terraform/main.tf (S3 BUCKET - PROFILE IMAGE UPLOADS
# section). After `terraform apply`, get the real values with:
#   terraform output profile_images_bucket_name
#   terraform output -raw profile_images_access_key_id
#   terraform output -raw profile_images_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=taskflow-pro-profile-images-xxxxxxxx
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
