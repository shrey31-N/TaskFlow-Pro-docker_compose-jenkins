# Copy this to .env.local (git-ignored) and adjust as needed.

# Where the Vite dev server proxies "/api" requests to (server.proxy in
# vite.config.js). Only used by `npm run dev`.
# Local docker-compose gateway:
VITE_API_PROXY_TARGET=http://localhost:8080
# Deployed ALB, if you want the dev server hitting the real backend:
# VITE_API_PROXY_TARGET=http://taskflow-pro-alb-79314755.ap-south-1.elb.amazonaws.com

# Base URL baked into a production build (src/api/axios.js). Leave unset to
# keep API calls relative to "/api", which only works if whatever serves the
# built app also forwards /api/** to the gateway. Set this to the gateway/ALB
# URL when the frontend is deployed somewhere that doesn't proxy for you.
# VITE_API_BASE_URL=http://taskflow-pro-alb-79314755.ap-south-1.elb.amazonaws.com/api
